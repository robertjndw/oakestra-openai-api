server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/json application/javascript text/javascript;

    # The backend may start after this container (or restart), so its name is resolved per
    # request instead of once at startup. NGINX_LOCAL_RESOLVERS is filled in by the image
    # entrypoint when NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # These keep their names across releases. If browsers cached them, the shell would keep
    # loading the previous addon version after an upgrade.
    location = /mf-manifest.json {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /remoteEntry.js {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The dashboard proxies /addon-assets/<name>/api/... here with its prefix removed, so the UI's
    # /api/v1/models reaches the backend's admin API as /admin/v1/models. The Authorization header
    # is forwarded by default; the backend decides who is an admin from it.
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        if ($api_upstream = "") {
            return 404;
        }
        client_max_body_size 1m;
        # A variable in proxy_pass disables nginx's own prefix replacement, so the rewrite does it.
        rewrite ^/api/(.*)$ /admin/$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Placing a model can make the backend wait on Oakestra for a while.
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri =404;
    }
}
