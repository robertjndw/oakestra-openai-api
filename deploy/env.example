# Addon environment for a real Oakestra install. In the marketplace flow these go into the
# "environment" block of the ooa service in oakestra-addon.json instead of a file. Every
# variable is documented in the README configuration table. Values shown for optional variables
# are the defaults.

# Service account on the root orchestrator. Create a dedicated user; Admin/Admin only
# belongs on a throwaway dev stack. Required.
OOA_OAKESTRA_USER=ooa
OOA_OAKESTRA_PASSWORD=change-me
# Organization name sent at login; empty means root.
# OOA_OAKESTRA_ORG=

# System manager base URL, and the API base used to validate dashboard tokens.
# OOA_OAKESTRA_API=http://system_manager:10000
# OOA_AUTH_URL=http://system_manager:10000/api

# Base URL external clients use for /v1, shown in the UI. Not a Docker-internal name.
# OOA_PUBLIC_URL=http://203.0.113.10:8095

# Listeners inside the container. The admin API must stay unreachable from outside.
# OOA_LISTEN=:8080
# OOA_ADMIN_LISTEN=:8081
# OOA_DATA_DIR=/data
# OOA_LOG_LEVEL=info

# Resource abstractor of each cluster (nodes are listed from there).
# OOA_CLUSTER_ABSTRACTOR_PORT=11012
# OOA_CLUSTER_ABSTRACTOR_OVERRIDES=cluster1=http://10.0.0.5:11012

# The one Oakestra application that owns every engine service. ^[a-zA-Z0-9]{1,32}$
# OOA_APP_NAME=openaiapi
# OOA_APP_NS=ooa

# Engines are published on this host port range of the node; open it in the firewall to the
# root host only.
# OOA_ENGINE_PORT_RANGE=18000-18999
# OOA_DEFAULT_ENGINE_IMAGE=vllm/vllm-openai:v0.29.0

# Driver name and volume attribute of the model CSI driver on the nodes. The name must equal the
# one the driver reports and that was given to "NodeEngine config csi add".
# OOA_MODEL_CSI_DRIVER=model.csi.modelpack.org
# OOA_MODEL_CSI_REF_KEY=model.csi.modelpack.org/reference
# OOA_MODEL_MOUNT_PATH=/model

# Deployment loop timing. The schedule timeout includes the model pull.
# OOA_POLL_INTERVAL=5s
# OOA_SCHEDULE_TIMEOUT=15m
# OOA_STARTUP_TIMEOUT=30m

# Routing for the model "auto" (seeds the setting on first start; the Settings page wins after).
# OOA_SCHEDULER=least-inflight
# OOA_MAX_ATTEMPTS=3
# OOA_MAX_BODY_BYTES=16MiB

# Adds deployment and node headers to /v1 responses. Leaks topology; debugging only.
# OOA_DEBUG_HEADERS=false

# introspect (default) or none. none treats every admin request as an Admin: tests only.
# OOA_ADMIN_AUTH=introspect
