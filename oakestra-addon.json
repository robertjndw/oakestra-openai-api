{
  "name": "openai-api",
  "description": "Manual OpenAI-compatible endpoint for Oakestra. Define models as ModelPack references, place them on nodes by hand and serve them behind one /v1 API on port 8095.",
  "services": [
    {
      "service_name": "ooa",
      "image": "ghcr.io/robertjndw/oakestra-openai-api:latest",
      "ports": {
        "8080/tcp": "8095"
      },
      "volumes": ["ooa_data:/data"],
      "environment": {
        "OOA_PUBLIC_URL": "http://CHANGE_ME:8095",
        "OOA_OAKESTRA_USER": "CHANGE_ME",
        "OOA_OAKESTRA_PASSWORD": "CHANGE_ME",
        "OOA_OAKESTRA_API": "http://system_manager:10000",
        "OOA_AUTH_URL": "http://system_manager:10000/api"
      }
    },
    {
      "service_name": "ooa_ui",
      "image": "ghcr.io/robertjndw/oakestra-openai-api-addon-ui:latest",
      "environment": {
        "API_UPSTREAM": "http://root_ooa:8081"
      }
    }
  ],
  "volumes": [
    {
      "name": "ooa_data"
    }
  ],
  "ui": {
    "service": "ooa_ui",
    "sdk": "^0.1.0"
  }
}
